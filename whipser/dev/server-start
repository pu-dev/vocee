#!/bin/bash
set -euo pipefail

WHISPER_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RUNNING_DIR="$WHISPER_DIR/__running"

PID_FILE="$RUNNING_DIR/server.pid"
LOG_FILE="$RUNNING_DIR/server.log"

mkdir -p "$RUNNING_DIR"

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "Server already running (pid $(cat "$PID_FILE"))" >&2
  exit 1
fi

source "$WHISPER_DIR/p3/bin/activate"

nohup "$WHISPER_DIR/dev/run-local" > "$LOG_FILE" 2>&1 &
echo $! > "$PID_FILE"
disown

sleep 1
if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "Server failed to start, check $LOG_FILE" >&2
  rm -f "$PID_FILE"
  exit 1
fi

echo "Started whisper server (pid $(cat "$PID_FILE")), logs: $LOG_FILE"
