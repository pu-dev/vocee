#!/bin/bash
set -euo pipefail

WHISPER_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PID_FILE="$WHISPER_DIR/__running/server.pid"

PIDS="$(lsof -i :9991 -sTCP:LISTEN -t || true)"

if [ -z "$PIDS" ]; then
  echo "No whisper server processes found" >&2
else
  echo "Killing whisper server processes: $PIDS"
  kill -9 $PIDS
fi

rm -f "$PID_FILE"
