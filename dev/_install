#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

./app/dev/kill-vocee || :
./app/dev/reset-accessibility || :
sleep 1
./app/dev/open-vocee

echo
echo "************************"
echo "README: Vocee needs Accessibility permission to paste text into the focused window."
echo "macOS will show a permission dialog now - you must approve it in System Settings."
echo "************************"
read -rp "Press Enter once Accessibility is enabled... "

./mlx-whisper/dev/install